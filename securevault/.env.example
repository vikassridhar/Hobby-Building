# ─── SecureVault Configuration ───
# Copy this file to .env and fill in the values

# ─── Core Secrets (REQUIRED) ───
VAULT_MASTER_KEY=change-me-to-a-random-32-byte-hex-string
SECUREVAULT_AGENT_TOKEN=change-me-to-a-secure-random-token

# ─── Telegram Bot (REQUIRED) ───
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Your Telegram user ID (numeric) — @userinfobot can tell you yours
TELEGRAM_USER_ID=your-telegram-user-id-here

# ─── Server ───
PORT=8443
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8443
NODE_ENV=production

# ─── TLS (optional — leave empty for HTTP) ───
TLS_CERT_PATH=
TLS_KEY_PATH=

# ─── Storage ───
VAULT_DB_PATH=./data/vault.db
AUDIT_LOG_PATH=./data/audit.log

# ─── Auto-Execute (optional) ───
# If enabled, tasks below the max amount are auto-approved
AUTO_EXECUTE_ENABLED=false
AUTO_EXECUTE_MAX_AMOUNT=100
AUTO_EXECUTE_CURRENCY=USD

# ─── Risk Assessment ───
RISK_TIMEZONE=UTC

# ─── Alpaca Trading ───
# Paper trading credentials
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
# Live trading credentials (use with caution!)
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Trading mode: paper (default) or live
TRADING_MODE=paper
# Auto-approve trades under this USD amount (0 = always require approval)
TRADE_APPROVAL_THRESHOLD=100
# Max % of portfolio a single position can occupy
TRADE_MAX_POSITION_PERCENT=25
